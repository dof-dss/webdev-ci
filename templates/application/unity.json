{
  "coding_standards_dirs": "${PROJECT_ROOT}/project/sites ${PROJECT_ROOT}/web/modules/custom ${PROJECT_ROOT}/web/modules/interim ${PROJECT_ROOT}/web/themes/custom ${PROJECT_ROOT}/web/profiles/unity ${PROJECT_ROOT}/web/profiles/origins",
  "custom_code_dirs": "${PROJECT_ROOT}/project/sites ${PROJECT_ROOT}/web/modules/custom ${PROJECT_ROOT}/web/modules/interim ${PROJECT_ROOT}/web/themes/custom ${PROJECT_ROOT}/web/profiles/unity ${PROJECT_ROOT}/web/profiles/origins",
  "deprecated_code_dirs": "${PROJECT_ROOT}/project/sites ${PROJECT_ROOT}/web/modules/custom ${PROJECT_ROOT}/web/modules/interim ${PROJECT_ROOT}/web/themes/custom ${PROJECT_ROOT}/web/profiles/unity ${PROJECT_ROOT}/web/profiles/origins",
  "edge_branch": "edge",
  "edge_build_dofdss_packages": "dof-dss/nicsdru_unity_theme:dev-11.x-dev dof-dss/nicsdru_origins_modules:dev-11.x-dev dof-dss/nicsdru_unity_modules:dev-11.x-dev dof-dss/nicsdru_unity_profile:dev-11.x-dev",
