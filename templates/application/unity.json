  "fastly": "uninstall",
  "theme_build_script": "build-themes.sh",
  "theme_asset_paths": ":(glob)project/sites/*/themes/*/css/**/*.css\n:(glob)project/sites/*/themes/*/images/**",
  "check_illegal_updates": true,
  "build_themes": true
